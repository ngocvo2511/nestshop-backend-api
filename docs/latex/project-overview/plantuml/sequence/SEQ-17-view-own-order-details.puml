@startuml
title SEQ-17 — View own order details
hide footbox
autonumber
skinparam sequenceMessageAlign left
skinparam maxMessageSize 300
skinparam responseMessageBelowArrow true
actor "Customer" as Caller
control "OrdersController" as Entry
control "JwtAuthGuard" as AuthGuard
control "RolesGuard" as RoleGuard
control "OrdersService" as Service
database "PostgreSQL\norders, order_items, payments\norder_status_history" as DB

activate Caller
Caller -> Entry: View own order details and history
activate Entry
Entry -> AuthGuard: Verify access token
activate AuthGuard
AuthGuard --> Entry: Return authentication outcome
deactivate AuthGuard
alt The access token is missing, invalid or expired
  Entry --> Caller: Invalid or missing access token
else The access token identifies an authenticated user
  Entry -> RoleGuard: Check CUSTOMER permission
  activate RoleGuard
  RoleGuard --> Entry: Return permission check outcome
  deactivate RoleGuard
  alt The user does not have the required permission
    Entry --> Caller: Permission denied
  else The role permits this operation
    Entry -> Service: getOwnOrder(customerId, orderId)
    activate Service
    Service -> DB: Find order by ID and owner
    activate DB
    DB --> Service: Return matching owned order
    deactivate DB
    alt The order is missing or belongs to another customer
      Service --> Entry: The requested order is unavailable.
      Entry --> Caller: The requested order is unavailable.
    else The order belongs to this customer
      Service -> DB: Read order snapshots, payment state and history
      activate DB
      DB --> Service: Return order details and history
      deactivate DB
      Service --> Entry: Return order details, payment state and history
      Entry --> Caller: Return order details, payment state and history
    end
    deactivate Service
  end
end
deactivate Entry
deactivate Caller
@enduml
