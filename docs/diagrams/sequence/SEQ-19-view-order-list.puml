@startuml
title SEQ-19 — View order list (Staff/Admin)
hide footbox
autonumber
skinparam sequenceMessageAlign left
skinparam maxMessageSize 300
skinparam responseMessageBelowArrow true
actor "Staff / Admin" as Caller
control "StaffOrdersController" as Entry
control "JwtAuthGuard" as AuthGuard
control "RolesGuard" as RoleGuard
control "OrdersService" as Service
database "PostgreSQL\norders, payments" as DB

activate Caller
Caller -> Entry: View fulfillment queue by status
activate Entry
Entry -> AuthGuard: Verify access token
activate AuthGuard
AuthGuard --> Entry: Return authentication outcome
deactivate AuthGuard
alt The access token is missing, invalid or expired
  Entry --> Caller: Invalid or missing access token
else The access token identifies an authenticated user
  Entry -> RoleGuard: Check STAFF or ADMIN permission
  activate RoleGuard
  RoleGuard --> Entry: Return permission check outcome
  deactivate RoleGuard
  alt The user does not have the required permission
    Entry --> Caller: Permission denied
  else The role permits this operation
    Entry -> Service: findFulfillmentQueue(actorId, query)
    activate Service
    Service -> Service: Validate order status filter
    alt The queue filter is invalid
      Service --> Entry: The fulfillment-queue filter is invalid.
      Entry --> Caller: The fulfillment-queue filter is invalid.
    else The queue filter is valid
      Service -> DB: Find authorized orders by status
      activate DB
      DB --> Service: Return fulfillment queue
      deactivate DB
      Service --> Entry: Return fulfillment queue
      Entry --> Caller: Return fulfillment queue
    end
    deactivate Service
  end
end
deactivate Entry
deactivate Caller
@enduml
