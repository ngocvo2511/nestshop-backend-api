@startuml
title SEQ-07 — Change password
hide footbox
autonumber
skinparam sequenceMessageAlign left
skinparam maxMessageSize 300
skinparam responseMessageBelowArrow true
actor "Customer" as Caller
control "UsersController" as Entry
control "JwtAuthGuard" as AuthGuard
control "UsersService" as Service
control "AuthService" as Auth
database "PostgreSQL\nusers, refresh_tokens" as DB

activate Caller
Caller -> Entry: Submit current and new passwords
activate Entry
Entry -> AuthGuard: Verify access token
activate AuthGuard
AuthGuard --> Entry: Return authentication outcome
deactivate AuthGuard
alt The access token is missing, invalid or expired
  Entry --> Caller: Invalid or missing access token
else The access token identifies an authenticated user
  Entry -> Service: changePassword(userId, dto)
  activate Service
  Service -> DB: Find current password hash
  activate DB
  DB --> Service: Return password hash
  deactivate DB
  Service -> Service: Verify current password and validate new password
  alt The current password is incorrect or the replacement is invalid
    Service --> Entry: Incorrect current password or invalid new password
    Entry --> Caller: Incorrect current password or invalid new password
  else Both password checks succeed
    Service -> Service: Hash new password
    Service -> DB: Save new password hash
    activate DB
    DB --> Service: Password change recorded
    deactivate DB
    Service -> Auth: revokeAllRefreshFamilies(userId, passwordChangeReason)
    activate Auth
    Auth -> DB: Revoke all user refresh families for password change
    activate DB
    DB --> Auth: Refresh-family revocations applied with password change
    deactivate DB
    Auth --> Service: Password change and refresh-session revocation applied together
    deactivate Auth
    Service --> Entry: Password changed; refresh sessions revoked\nAccess tokens remain valid until expiry
    Entry --> Caller: Password changed; refresh sessions revoked\nAccess tokens remain valid until expiry
  end
  deactivate Service
end
deactivate Entry
deactivate Caller
@enduml
