graph ConceptualERD {
graph [rankdir=LR, bgcolor="#f8fafc", pad=0.4, nodesep=0.45, ranksep=0.7, splines=polyline, fontname="Arial", fontsize=18, labelloc=t, label="E-COMMERCE | CONCEPTUAL ERD (CHEN)\nRectangle = entity; diamond = relationship; labels = min..max cardinality\nP0 scope | 10 entities / 12 relationships\nSYSTEM history has no user actor; unknown IPN has no payment link"];
node [fontname="Arial", fontsize=13, penwidth=1.5];
edge [fontname="Arial", fontsize=11, color="#64748b", penwidth=1.2];
users [shape=box, style="rounded,filled", fillcolor="#1d4ed8", color="#1d4ed8", fontcolor=white, margin="0.2,0.15", label="users"];
refresh_tokens [shape=box, style="rounded,filled", fillcolor="#1d4ed8", color="#1d4ed8", fontcolor=white, margin="0.2,0.15", label="refresh_tokens"];
role_change_audit [shape=box, style="rounded,filled", fillcolor="#1d4ed8", color="#1d4ed8", fontcolor=white, margin="0.2,0.15", label="role_change_audit"];
products [shape=box, style="rounded,filled", fillcolor="#0f766e", color="#0f766e", fontcolor=white, margin="0.2,0.15", label="products"];
inventory_adjustment_audit [shape=box, style="rounded,filled", fillcolor="#0f766e", color="#0f766e", fontcolor=white, margin="0.2,0.15", label="inventory_adjustment_audit"];
orders [shape=box, style="rounded,filled", fillcolor="#7c3aed", color="#7c3aed", fontcolor=white, margin="0.2,0.15", label="orders"];
order_items [shape=box, style="rounded,filled", fillcolor="#7c3aed", color="#7c3aed", fontcolor=white, margin="0.2,0.15", label="order_items"];
order_status_history [shape=box, style="rounded,filled", fillcolor="#7c3aed", color="#7c3aed", fontcolor=white, margin="0.2,0.15", label="order_status_history"];
payments [shape=box, style="rounded,filled", fillcolor="#b45309", color="#b45309", fontcolor=white, margin="0.2,0.15", label="payments"];
payment_notifications [shape=box, style="rounded,filled", fillcolor="#b45309", color="#b45309", fontcolor=white, margin="0.2,0.15", label="payment_notifications"];
r0 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="owns session tokens", fontsize=11];
users -- r0 [taillabel="1", labeldistance=1.8];
r0 -- refresh_tokens [headlabel="0..N", labeldistance=1.8];
r1 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="performs role change", fontsize=11];
users -- r1 [taillabel="1", labeldistance=1.8];
r1 -- role_change_audit [headlabel="0..N", labeldistance=1.8];
r2 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="is subject of change", fontsize=11];
users -- r2 [taillabel="1", labeldistance=1.8];
r2 -- role_change_audit [headlabel="0..N", labeldistance=1.8];
r3 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="places", fontsize=11];
users -- r3 [taillabel="1", labeldistance=1.8];
r3 -- orders [headlabel="0..N", labeldistance=1.8];
r4 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="has stock adjustments", fontsize=11];
products -- r4 [taillabel="1", labeldistance=1.8];
r4 -- inventory_adjustment_audit [headlabel="0..N", labeldistance=1.8];
r5 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="performs adjustment", fontsize=11];
users -- r5 [taillabel="1", labeldistance=1.8];
r5 -- inventory_adjustment_audit [headlabel="0..N", labeldistance=1.8];
r6 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="contains", fontsize=11];
orders -- r6 [taillabel="1", labeldistance=1.8];
r6 -- order_items [headlabel="1..N", labeldistance=1.8];
r7 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="is purchased as", fontsize=11];
products -- r7 [taillabel="1", labeldistance=1.8];
r7 -- order_items [headlabel="0..N", labeldistance=1.8];
r8 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="has transition history", fontsize=11];
orders -- r8 [taillabel="1", labeldistance=1.8];
r8 -- order_status_history [headlabel="1..N", labeldistance=1.8];
r9 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="acts on transition", fontsize=11];
users -- r9 [taillabel="0..1", labeldistance=1.8];
r9 -- order_status_history [headlabel="0..N", labeldistance=1.8];
r10 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="has payment attempts", fontsize=11];
orders -- r10 [taillabel="1", labeldistance=1.8];
r10 -- payments [headlabel="0..N", labeldistance=1.8];
r11 [shape=diamond, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="receives IPN records", fontsize=11];
payments -- r11 [taillabel="0..1", labeldistance=1.8];
r11 -- payment_notifications [headlabel="0..N", labeldistance=1.8];
}
