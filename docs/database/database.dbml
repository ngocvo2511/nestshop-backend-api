Project ecommerce {
  database_type: 'PostgreSQL'
  Note: 'Proposed P0 design, SRS v0.8. See database-design.md and schema.sql for transactional rules and PostgreSQL partial indexes.'
}

Table users {
  Note: 'P0 Users: one role per account; deactivate rather than delete. Avatar remains unselected.'
  id uuid [pk, not null]
  email varchar(254) [not null, unique]
  password_hash text [not null]
  role varchar(16) [not null, default: 'CUSTOMER']
  is_active boolean [not null, default: true]
  full_name varchar(200) [null]
  phone_number varchar(32) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `email = lower(btrim(email)) AND length(email) > 3` [name: 'users_email_normalized']
    `length(btrim(password_hash)) > 0` [name: 'users_password_hash_present']
    `role IN ('CUSTOMER','STAFF','ADMIN')` [name: 'users_role_valid']
  }
}

Table refresh_tokens {
  Note: 'P0 Auth: hash-only refresh tokens. family_id groups rotations; serialize all auth mutations on the owning user row. ACTIVE plus consumed_at means rotated, not usable.'
  id uuid [pk, not null]
  user_id uuid [not null]
  family_id uuid [not null, note: 'Application-generated family UUID, invariant owner enforced transactionally.']
  token_hash varchar(64) [not null, unique, note: 'SHA-256 hex of a high-entropy refresh token, never the token itself.']
  status varchar(16) [not null, default: 'ACTIVE']
  consumed_at timestamptz [null]
  revoked_at timestamptz [null]
  revocation_reason varchar(24) [null]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: 'Persist configured deadline explicitly; do not infer from current configuration.']
  indexes {
    (user_id, family_id) [name: 'refresh_user_family_idx']
  }
  checks {
    `token_hash ~ '^[0-9a-f]{64}$'` [name: 'refresh_hash_format']
    `status IN ('ACTIVE','REVOKED','EXPIRED')` [name: 'refresh_status_valid']
    `expires_at > created_at` [name: 'refresh_expiry_valid']
    `consumed_at IS NULL OR consumed_at >= created_at` [name: 'refresh_consumption_valid']
    `(status = 'REVOKED' AND revoked_at IS NOT NULL AND revoked_at >= created_at AND revocation_reason IS NOT NULL AND revocation_reason IN ('LOGOUT','PASSWORD_CHANGE','REPLAY')) OR (status <> 'REVOKED' AND revoked_at IS NULL AND revocation_reason IS NULL)` [name: 'refresh_revocation_valid']
  }
  // refresh_one_live_token_idx: UNIQUE (family_id) WHERE status = 'ACTIVE' AND consumed_at IS NULL
}

Table role_change_audit {
  Note: 'P0 Users: immutable successful Admin role changes.'
  id uuid [pk, not null]
  actor_user_id uuid [not null]
  affected_user_id uuid [not null]
  old_role varchar(16) [not null]
  new_role varchar(16) [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (affected_user_id, created_at, id) [name: 'role_audit_target_time_idx']
    (actor_user_id) [name: 'role_audit_actor_idx']
  }
  checks {
    `old_role IN ('CUSTOMER','STAFF','ADMIN') AND new_role IN ('CUSTOMER','STAFF','ADMIN') AND old_role <> new_role` [name: 'role_audit_values']
  }
}

Table products {
  Note: 'P0 Products and Inventory: available stock only. One optional local image relative path; gallery not required.'
  id uuid [pk, not null]
  name varchar(250) [not null]
  description text [null]
  price_vnd bigint [not null]
  stock_available integer [not null]
  is_active boolean [not null, default: true]
  image_path varchar(512) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (is_active, name, id) [name: 'product_public_name_idx']
    (is_active, price_vnd, id) [name: 'product_public_price_idx']
  }
  checks {
    `length(btrim(name)) > 0` [name: 'product_name_present']
    `price_vnd > 0` [name: 'product_price_positive']
    `stock_available >= 0` [name: 'product_stock_nonnegative']
    `image_path IS NULL OR (length(btrim(image_path)) > 0 AND image_path !~ '(^/|[\\:]|(^|/)\.\.(/|$))')` [name: 'product_image_relative']
  }
}

Table inventory_adjustment_audit {
  Note: 'P0 Inventory: immutable manual adjustments only; not checkout reservations.'
  id uuid [pk, not null]
  product_id uuid [not null]
  actor_user_id uuid [not null]
  previous_stock integer [not null]
  quantity_delta integer [not null]
  new_stock integer [not null]
  reason text [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (product_id, created_at, id) [name: 'inventory_audit_product_time_idx']
    (actor_user_id) [name: 'inventory_audit_actor_idx']
  }
  checks {
    `previous_stock >= 0 AND new_stock >= 0 AND quantity_delta <> 0 AND previous_stock::bigint + quantity_delta::bigint = new_stock::bigint` [name: 'inventory_audit_quantities']
    `length(btrim(reason)) > 0` [name: 'inventory_audit_reason']
  }
}

Table orders {
  Note: 'P0 Orders: immutable checkout shipping snapshot. reservation_expires_at is created_at plus configured 60 minutes.'
  id uuid [pk, not null]
  user_id uuid [not null]
  status varchar(24) [not null, default: 'PENDING_PAYMENT']
  total_vnd bigint [not null]
  recipient_name varchar(200) [not null]
  recipient_phone varchar(32) [not null]
  address_line varchar(500) [not null]
  ward varchar(150) [null]
  district varchar(150) [null]
  province_city varchar(150) [not null]
  postal_code varchar(20) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  reservation_expires_at timestamptz [not null]
  indexes {
    (user_id, created_at, id) [name: 'order_customer_time_idx']
    (status, created_at, id) [name: 'order_queue_idx']
  }
  checks {
    `status IN ('PENDING_PAYMENT','PAID','PROCESSING','SHIPPED','COMPLETED','CANCELLED','EXPIRED')` [name: 'order_status_valid']
    `total_vnd > 0` [name: 'order_total_positive']
    `length(btrim(recipient_name)) > 0 AND length(btrim(recipient_phone)) > 0 AND length(btrim(address_line)) > 0 AND length(btrim(province_city)) > 0` [name: 'order_shipping_present']
    `reservation_expires_at > created_at` [name: 'order_expiry_valid']
  }
  // order_due_idx: (reservation_expires_at, id) WHERE status = 'PENDING_PAYMENT'
}

Table order_items {
  Note: 'P0 Orders: immutable purchase snapshots and reserved quantities. line_total_vnd is SQL GENERATED ALWAYS AS (unit_price_vnd * quantity::bigint) STORED; never writable.'
  id uuid [pk, not null]
  order_id uuid [not null]
  product_id uuid [not null]
  product_name varchar(250) [not null]
  unit_price_vnd bigint [not null]
  quantity integer [not null]
  line_total_vnd bigint [null, note: 'Generated stored expression in SQL; DBML has no generated-column setting.']
  indexes {
    (product_id) [name: 'item_product_idx']
    (order_id, product_id) [unique, name: 'order_item_product_unique']
  }
  checks {
    `length(btrim(product_name)) > 0` [name: 'item_name_present']
    `unit_price_vnd > 0 AND quantity > 0` [name: 'item_values_positive']
  }
}

Table order_status_history {
  Note: 'P0 Orders: immutable transition history; null actor means SYSTEM; null previous_status is creation.'
  id uuid [pk, not null]
  order_id uuid [not null]
  actor_user_id uuid [null]
  previous_status varchar(24) [null]
  new_status varchar(24) [not null]
  note text [null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (order_id, created_at, id) [name: 'history_order_time_idx']
    (actor_user_id) [name: 'history_actor_idx']
  }
  checks {
    `(previous_status IS NULL AND new_status = 'PENDING_PAYMENT' AND actor_user_id IS NULL) OR (previous_status IS NOT NULL AND ((previous_status = 'PENDING_PAYMENT' AND new_status IN ('PAID','CANCELLED','EXPIRED')) OR (previous_status = 'PAID' AND new_status = 'PROCESSING') OR (previous_status = 'PROCESSING' AND new_status = 'SHIPPED') OR (previous_status = 'SHIPPED' AND new_status = 'COMPLETED')))` [name: 'history_transition_valid']
    `new_status NOT IN ('CANCELLED','PROCESSING','SHIPPED','COMPLETED') OR actor_user_id IS NOT NULL` [name: 'history_human_actor']
  }
  // history_one_initial_idx: UNIQUE (order_id) WHERE previous_status IS NULL
}

Table payments {
  Note: 'P0 Payments: each row is an attempt. expires_at is created_at plus configured approximately 20 minutes; not provider finality. Partial unique indexes enforce one PENDING and one SUCCESS per order.'
  id uuid [pk, not null]
  order_id uuid [not null]
  provider varchar(16) [not null, default: 'VNPAY']
  provider_reference varchar(100) [not null, unique]
  provider_transaction_reference varchar(100) [null]
  status varchar(16) [not null, default: 'PENDING']
  amount_vnd bigint [not null]
  currency varchar(3) [not null, default: 'VND']
  payment_url text [not null, note: 'Sensitive signed redirect URL; do not log; return only to authorized owner.']
  response_code varchar(32) [null]
  transaction_status_code varchar(32) [null]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: 'Persist configured deadline explicitly; do not infer from current configuration.']
  terminal_at timestamptz [null]
  indexes {
    (order_id, created_at, id) [name: 'payment_order_time_idx']
  }
  checks {
    `status IN ('PENDING','SUCCESS','FAILED','EXPIRED')` [name: 'payment_status_valid']
    `provider = 'VNPAY'` [name: 'payment_provider_valid']
    `currency = 'VND'` [name: 'payment_currency_valid']
    `amount_vnd > 0` [name: 'payment_amount_positive']
    `length(btrim(provider_reference)) > 0 AND length(btrim(payment_url)) > 0` [name: 'payment_reference_present']
    `expires_at > created_at` [name: 'payment_expiry_valid']
    `(status = 'PENDING' AND terminal_at IS NULL) OR (status <> 'PENDING' AND terminal_at IS NOT NULL AND terminal_at >= created_at)` [name: 'payment_terminal_valid']
  }
  // payment_one_pending_idx: UNIQUE (order_id) WHERE status = 'PENDING'
  // payment_one_success_idx: UNIQUE (order_id) WHERE status = 'SUCCESS'
  // payment_due_idx: (expires_at, id) WHERE status = 'PENDING'
}

Table payment_notifications {
  Note: 'P0 Payments: safe append-only IPN receipts, including duplicates and non-settling late results. Nullable payment_id supports unknown references. No raw payloads or credentials.'
  id uuid [pk, not null]
  payment_id uuid [null]
  correlation_id uuid [not null]
  provider_reference varchar(100) [null]
  provider_transaction_reference varchar(100) [null]
  signature_verified boolean [not null]
  reported_amount_vnd bigint [null, note: 'Untrusted reported amount unless signature and business validation succeed; nullable when malformed.']
  reported_currency varchar(16) [null]
  response_code varchar(32) [null]
  transaction_status_code varchar(32) [null]
  outcome varchar(24) [not null]
  safe_detail text [null]
  received_at timestamptz [not null, default: `now()`]
  indexes {
    (payment_id, received_at, id) [name: 'notification_payment_time_idx']
    (outcome, received_at, id) [name: 'notification_outcome_time_idx']
    (correlation_id) [name: 'notification_correlation_idx']
  }
  checks {
    `outcome IN ('SETTLED','FAILED','DUPLICATE','INVALID','MISMATCH','UNKNOWN_REFERENCE','LATE','CONFLICT')` [name: 'notification_outcome_valid']
    `outcome NOT IN ('SETTLED','FAILED') OR (signature_verified AND payment_id IS NOT NULL AND reported_amount_vnd IS NOT NULL AND reported_amount_vnd > 0 AND reported_currency IS NOT NULL AND reported_currency = 'VND')` [name: 'notification_verified_effect']
  }
}

Ref: refresh_tokens.user_id > users.id [delete: restrict, update: restrict]
Ref: role_change_audit.actor_user_id > users.id [delete: restrict, update: restrict]
Ref: role_change_audit.affected_user_id > users.id [delete: restrict, update: restrict]
Ref: inventory_adjustment_audit.product_id > products.id [delete: restrict, update: restrict]
Ref: inventory_adjustment_audit.actor_user_id > users.id [delete: restrict, update: restrict]
Ref: orders.user_id > users.id [delete: restrict, update: restrict]
Ref: order_items.order_id > orders.id [delete: restrict, update: restrict]
Ref: order_items.product_id > products.id [delete: restrict, update: restrict]
Ref: order_status_history.order_id > orders.id [delete: restrict, update: restrict]
Ref: order_status_history.actor_user_id > users.id [delete: restrict, update: restrict]
Ref: payments.order_id > orders.id [delete: restrict, update: restrict]
Ref: payment_notifications.payment_id > payments.id [delete: restrict, update: restrict]

TableGroup Identity {
  users
  refresh_tokens
  role_change_audit
}

TableGroup CatalogInventory {
  products
  inventory_adjustment_audit
}

TableGroup Purchasing {
  orders
  order_items
  order_status_history
}

TableGroup PaymentProcessing {
  payments
  payment_notifications
}
