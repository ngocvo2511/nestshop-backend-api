products [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0f766e" ALIGN="LEFT"><FONT COLOR="white"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e">&#160;</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">varchar(250)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e">&#160;</FONT></TD><TD ALIGN="LEFT">price_vnd</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e">&#160;</FONT></TD><TD ALIGN="LEFT">stock_available</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e">&#160;</FONT></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e">&#160;</FONT></TD><TD ALIGN="LEFT">image_path?</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">varchar(512)</FONT></TD></TR></TABLE>>];
