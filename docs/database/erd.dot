digraph ERD {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.45", nodesep="0.65", ranksep="1.25", splines=polyline, outputorder=edgesfirst, fontname="Arial", label="E-COMMERCE BACKEND | LOGICAL ERD (P0)\n10 entities / 12 relationships | Selected business attributes\nPK = primary key    FK = foreign key    UK = unique key\nCrow foot + circle = 0..N children; bar = 1 parent; circle = optional parent\nOrder must contain at least 1 item and 1 history row (transaction rule)", labelloc=t, fontsize=16];
node [shape=plain, fontname="Arial"];
edge [color="#64748b", penwidth=1.3, arrowsize=0.8, fontname="Arial", fontsize=10];
users [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#1d4ed8" ALIGN="LEFT"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">UK</FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">varchar(254)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">varchar(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8">&#160;</FONT></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">boolean</FONT></TD></TR></TABLE>>];
